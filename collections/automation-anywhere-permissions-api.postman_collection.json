          "id": "89818eef-072b-4e73-b22b-355aeb55b363",
          "name": "Update role permissions",
          "request": {
            "name": "Update role permissions",
            "description": {
              "content": "Adds or updates the repository folder permissions granted to a specific role. Permissions are specified as a list of folder-action pairs, enabling fine-grained access control over which operations a role can perform on each folder.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "role",
                ":roleid",
                "permissions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
