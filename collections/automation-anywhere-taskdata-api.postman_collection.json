                  "disabled": false,
                  "key": "from",
                  "value": "<date>",
                  "description": "Start of the date range in ISO 8601 format (YYYY-MM-DD)"
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<date>",
                  "description": "End of the date range in ISO 8601 format (YYYY-MM-DD). Must not be more than 60 days after the from date."
