          "request": {
            "name": "Get bot run data",
            "description": {
              "content": "Retrieves bot execution run records for a specific date or date range. Each record contains details about a single bot run including user, device, start/end times, status, and performance metrics. Results are paginated at 1000 records per request. Dates must be in ISO 8601 format and the date range cannot exceed 60 days.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "getbotrundata",
                ":startIndex",
                ":startDate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "0",
                  "key": "startIndex",
                  "description": "(Required) Zero-based record index for pagination. Set to 0 to retrieve the first page of 1000 records, then increment by 1000 for subsequent pages."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<date>",
                  "key": "startDate",
                  "description": "(Required) Start date for the data query in ISO 8601 format (YYYY-MM-DD)"
                },
                {
                  "description": "Your Control Room hostname",
                  "type": "any",
                  "value": "{{controlRoomUrl}}",
                  "key": "controlRoomUrl"
                }
              ]
            },
