          "id": "905f94db-500b-4fd4-a92d-9cc61ebc6d02",
          "name": "List API Task allocations",
          "request": {
            "name": "List API Task allocations",
            "description": {
              "content": "Returns a paginated list of all API Tasks that have been allocated (registered) for real-time execution within the Control Room. Administrators must allocate an API Task before developers can generate execution URLs for it. Use this endpoint to verify that a specific API Task is available before requesting access details.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "config"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Control Room hostname",
                  "type": "any",
                  "value": "{{controlRoomUrl}}",
                  "key": "controlRoomUrl"
                }
              ]
            },
            "header": [
