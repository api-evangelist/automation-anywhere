          "id": "448262c3-b5d6-417f-adce-7f1389fb3e86",
          "name": "Generate API Task execution URL and token",
          "request": {
            "name": "Generate API Task execution URL and token",
            "description": {
              "content": "Generates a unique execution URL and short-lived authorization token for one or more API Tasks identified by their repository paths. The returned URL is used to invoke the API Task directly without going through the standard Control Room authentication flow. Both the URL and token are time-limited and should be refreshed periodically (recommended every 5 minutes) to prevent authorization failures during long-running integrations.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "config",
                "accessdetails"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Control Room hostname",
                  "type": "any",
                  "value": "{{controlRoomUrl}}",
                  "key": "controlRoomUrl"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"botRepositoryPath\": [\n    \"<string>\",\n    \"<string>\"\n  ]\n}",
