        {
          "id": "05723fcf-b3ab-49a1-87c4-ac0624c520ec",
          "name": "List credential attribute values",
          "request": {
            "name": "List credential attribute values",
            "description": {
              "content": "Retrieves all attribute values for a specific credential. Returns the current values of each attribute defined on the credential. The credentialAttributeId, userId, and encryptionKey query parameters can be used to filter the returned attribute values.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "credentials",
                ":id",
                "attributevalues"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "credentialAttributeId",
                  "value": "<long>",
                  "description": "Filter attribute values by this credential attribute ID"
                },
                {
                  "disabled": false,
                  "key": "userId",
                  "value": "<long>",
                  "description": "Filter attribute values scoped to this user ID"
                },
                {
                  "disabled": false,
                  "key": "encryptionKey",
                  "value": "<string>",
                  "description": "Encryption key identifier for decrypting attribute values"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<long>",
                  "key": "id",
                  "description": "(Required) Unique numeric identifier of the credential"
                },
                {
                  "description": "Your Control Room hostname",
                  "type": "any",
                  "value": "{{controlRoomUrl}}",
                  "key": "controlRoomUrl"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
