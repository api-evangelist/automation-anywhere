          "name": "Deploy a bot",
          "request": {
            "name": "Deploy a bot",
            "description": {
              "content": "Deploys an automation bot from the public workspace to one or more Bot Runner devices. Supports unattended deployment (to devices linked to a specified user), attended deployment (to any device accessible to the user), and headless deployment (to On-Demand Bot Runner devices). Returns a deploymentId that can be used to monitor the execution status. Input variables can be passed at runtime via the botInput field.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "automations",
                "deploy"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Control Room hostname",
                  "type": "any",
                  "value": "{{controlRoomUrl}}",
                  "key": "controlRoomUrl"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
