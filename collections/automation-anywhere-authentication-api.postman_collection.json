          "name": "Authenticate and generate JWT",
          "request": {
            "name": "Authenticate and generate JWT",
            "description": {
              "content": "Authenticates a Control Room user using username and password or username and API key, and returns a JSON Web Token (JWT) for use in subsequent API calls. The token is valid for 20 minutes by default and must be included in the X-Authorization or Authorization header of all subsequent requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "authentication"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your Control Room hostname",
                  "type": "any",
                  "value": "{{controlRoomUrl}}",
                  "key": "controlRoomUrl"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"<string>\",\n  \"password\": \"<string>\",\n  \"apiKey\": \"<string>\",\n  \"multipleLogin\": \"<boolean>\"\n}",
