        {
          "id": "1b3878c6-6051-48c5-90b0-77d36664aade",
          "name": "Create work items from a file",
          "request": {
            "name": "Create work items from a file",
            "description": {
              "content": "Bulk-creates work items in a queue by uploading a CSV or Excel file. Each row in the file becomes a work item mapped to the queue's work item model attributes. This is the recommended approach for high-volume data ingestion into RPA queues.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "queues",
                ":id",
                "file"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
